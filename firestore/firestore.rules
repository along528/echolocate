rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cache is written server-side only; no client reads needed
    match /semantic_search_cache/{document=**} {
      allow read, write: if false;
    }

    // Existing collections retain default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
